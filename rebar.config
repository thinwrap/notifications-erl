%% Zero runtime dependencies by design: everything below is build/test tooling
%% that never reaches a consumer's dependency tree.
{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

{deps, []}.

{project_plugins, [
    {rebar3_hex, "7.4.0"},
    {rebar3_ex_doc, "0.3.0"},
    {erlfmt, "1.8.0"},
    {rebar3_lint, "6.0.0"},
    {rebar3_hank, "2.0.1"}
]}.

{erlfmt, [
    write,
    {files, ["{src,test}/*.{erl,hrl,app.src}", "rebar.config"]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, unknown]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, inets, ssl, public_key]}
]}.

%% rebar3_hank (dead code). The transport and provider modules DEFINE the
%% callbacks that implementers use, so "unused callback" there is by design.
{hank, [
    {ignore, [
        {"src/thinwrap_notifications_transport.erl", unused_callbacks},
        {"src/thinwrap_notifications_provider.erl", unused_callbacks}
    ]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_excl_mods, [thinwrap_notifications_fake_transport]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec, nowarn_export_all]}
    ]}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {source_url, <<"https://github.com/thinwrap/notifications-erl">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"readme">>}
]}.
